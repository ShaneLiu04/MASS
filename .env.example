# MASS 环境变量配置示例
# 复制此文件为 .env 并填入你的实际配置

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# CORS 跨域白名单（逗号分隔多个来源，生产环境严禁使用 *）
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ───────────────────────────────────────────────
# LLM API 配置 — DeepSeek 为默认提供商
# ───────────────────────────────────────────────
LLM_PROVIDER=deepseek

# DeepSeek 配置（默认主源）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI 配置（备选）
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Claude 配置（备选）
# CLAUDE_API_KEY=your-claude-key
# CLAUDE_BASE_URL=https://api.anthropic.com/v1

# Ollama 配置（本地模型）
# OLLAMA_BASE_URL=http://localhost:11434

# 默认模型 — DeepSeek-V4-Pro
DEFAULT_MODEL=deepseek-v4-pro
CHAIRMAN_MODEL=deepseek-v4-pro
PREDICTION_MODEL=deepseek-v4-pro

# LLM 调用参数（全部可调）
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_MAX_TOKENS=4096
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0

# 系统配置
USE_MOCK_LLM=True
AGENT_PARALLEL=True
MAX_CONCURRENT_AGENTS=6
CACHE_TTL_SECONDS=300

# 情感分析引擎: true=LLM(高精度慢速), false=增强规则引擎(快速默认)
USE_LLM_SENTIMENT=false

# TuShare
TUSHARE_TOKEN=your-tushare-token

# 爬虫配置
CRAWLER_REQUEST_INTERVAL=0.5
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT=30
CRAWLER_ENABLE_EASTMONEY=True
CRAWLER_ENABLE_THS=True

# 回测
VALIDATION_LOOKAHEAD_DAYS=20
